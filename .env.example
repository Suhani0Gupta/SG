# Environment Variables for Job Radar
# Copy to .env and configure secrets

# Security & Encryption (32-byte url-safe base64 key for Fernet, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
ENCRYPTION_KEY="replace-with-fernet-compatible-base64-key-32-bytes"

# Database (default SQLite for local/home server; supports PostgreSQL for scale)
DATABASE_URL="sqlite:///./data/job_radar.db"

# LLM Configuration (Anthropic Claude - default claude-sonnet-5-5 or Gemini if configured)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
GEMINI_API_KEY=""

# Source Free Tier APIs (Optional for Phase 1c)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
JSEARCH_API_KEY=""

# Cost & Quota Controls
MONTHLY_API_BUDGET_USD=10.0
MAX_DAILY_LLM_CALLS_PER_USER=50

# Schedulers & Workers (minutes, default 30-60 min)
SCRAPER_POLL_INTERVAL_MINUTES=45
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="JobRadar/1.0 (+https://github.com/job-radar/bot; private personal research)"

# App Runtime
PORT=3000
HOST="0.0.0.0"
ENVIRONMENT="production"
